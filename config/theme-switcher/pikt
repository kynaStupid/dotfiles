#!/usr/bin/env bash
set -euo pipefail

THEME_ROOT="${THEME_ROOT:-@THEME_SWITCHER_ROOT@}"
THEMES_DIR="$THEME_ROOT/themes"
ACTIVE_DIR="$THEME_ROOT/active"
STATE_FILE="$THEME_ROOT/current"
NVIM_SOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}/nvim-theme-sockets"

list_themes() {
	find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

usage() {
	cat >&2 <<EOF
usage: theme-switch <theme-id>
       theme-switch --list
       theme-switch --current
Sheb
available themes:
$(list_themes | sed 's/^/  /')
EOF
}

case "${1:-}" in
	-l|--list)
		list_themes
		exit 0
		;;
	-c|--current)
		cat "$STATE_FILE" 2>/dev/null || echo "(none set)"
		exit 0
		;;
	-h|--help|"")
		usage
		exit 1
		;;
esac

name="$1"
dir="$THEMES_DIR/$name"

if [ ! -d "$dir" ]; then
	echo "error: unknown theme '$name'" >&2
	usage
	exit 1
fi

meta="$dir/meta.json"
if [ ! -f "$meta" ]; then
	echo "error: $meta missing — rebuild home-manager first" >&2
	exit 1
fi

dark=$(jq -r '.dark' "$meta")
gtk_name=$(jq -r '.gtk.name' "$meta")
qt_name=$(jq -r '.qt.name' "$meta")
icon_name=$(jq -r '.icons.name' "$meta")
cursor_name=$(jq -r '.cursor.name' "$meta")
cursor_size=$(jq -r '.cursor.size' "$meta")
font_name=$(jq -r '.font.name' "$meta")
font_size=$(jq -r '.font.size' "$meta")

mkdir -p "$ACTIVE_DIR"

# gtk / icons / cursor

if [[ "$dark" == "true" ]]; then
	gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true
else
	gsettings set org.gnome.desktop.interface color-scheme "prefer-light" 2>/dev/null || true
fi
gsettings set org.gnome.desktop.interface gtk-theme "$gtk_name" 2>/dev/null || true
gsettings set org.gnome.desktop.interface icon-theme "$icon_name" 2>/dev/null || true
gsettings set org.gnome.desktop.interface cursor-theme "$cursor_name" 2>/dev/null || true
gsettings set org.gnome.desktop.interface cursor-size "$cursor_size" 2>/dev/null || true
gsettings set org.gnome.desktop.interface font-name "$font_name $font_size" 2>/dev/null || true

mkdir -p ~/.icons/default

cat > ~/.icons/default/index.theme <<EOF
[Icon Theme]
Name=Default
Comment=Default Cursor Theme
Inherits=$cursor_name
EOF

# qt / kvantum

sed -i "s/^theme=.*/theme=$qt_name/" "$HOME/.config/Kvantum/kvantum.kvconfig"

# mango

if [ -f "$dir/mango-theme.conf" ]; then
	ln -sfn "$dir/mango-theme.conf" "$ACTIVE_DIR/mango-theme.conf"
	if command -v mmsg >/dev/null 2>&1; then
		mmsg dispatch reload_config >/dev/null || echo "warn: mango reload failed" >&2
	fi
fi

# quickshell

if [ -f "$dir/quickshell-theme.json" ]; then
	cat "$dir/quickshell-theme.json" > "$ACTIVE_DIR/quickshell-theme.json"
	(quickshell kill >/dev/null && quickshell >/dev/null 2>&1 &) || echo "warn: quickshell restart failed" >&2
fi

# rofi

if [ -f "$dir/rofi-theme.rasi" ]; then
	ln -sfn "$dir/rofi-theme.rasi" "$ACTIVE_DIR/rofi-theme.rasi"
fi

# alacritty

if [ -f "$dir/alacritty-theme.toml" ]; then
	cat "$dir/alacritty-theme.toml" > "$ACTIVE_DIR/alacritty-theme.toml"
fi

# zsh
if [ -f "$dir/zsh-prompt.zsh" ]; then
	ln -sfn "$dir/zsh-prompt.zsh" "$ACTIVE_DIR/zsh-prompt.zsh"
fi

if [ -f "$dir/fsh-theme.ini" ]; then
	ln -sfn "$dir/fsh-theme.ini" "$ACTIVE_DIR/fsh-theme.ini"
fi

pkill -USR2 -x zsh 2>/dev/null || true

# --- waybar: no hot-reload for JSON side, but restart is cheap and near-instant ---
# if pgrep -x waybar >/dev/null 2>&1; then
# 	pkill -SIGUSR2 waybar || true
# fi

# --- mako ---
# if command -v makoctl >/dev/null 2>&1; then
# 	makoctl reload || true
# fi

# --- wallpaper, only if this theme carries one ---
# if [ -f "$dir/wallpaper" ] && command -v awww >/dev/null 2>&1; then
# 	wallpaper_path="$(cat "$dir/wallpaper")"
# 	awww img "$wallpaper_path" || echo "warn: wallpaper set failed" >&2
# fi

# neovim

if [ -f "$dir/nvim-theme.lua" ]; then
	cat "$dir/nvim-theme.lua" > "$ACTIVE_DIR/nvim-theme.lua"
fi

if [ -d "$NVIM_SOCK_DIR" ]; then
	for sock in "$NVIM_SOCK_DIR"/*.sock; do
		[ -S "$sock" ] || continue
		nvim --server "$sock" \
			--remote-send '<Cmd>lua require("theme").apply()<CR>' \
			>/dev/null 2>&1 || true
	done
fi

if [ -f "$dir/btop-theme.theme" ]; then
	ln -sfn "$dir/btop-theme.theme" "$ACTIVE_DIR/btop-theme.theme"
	mkdir -p "$HOME/.config/btop/themes"
	ln -sfn "$dir/btop-theme.theme" "$HOME/.config/btop/themes/pikt.theme"
	pkill -USR2 -x btop 2>/dev/null || true
fi

# qutebrowser

if [ -f "$dir/qutebrowser-theme.py" ]; then
	ln -sfn "$dir/qutebrowser-theme.py" "$ACTIVE_DIR/qutebrowser-theme.py"
	pgrep -x qutebrowser && qutebrowser ":config-source" || true
fi

echo "$name" > "$STATE_FILE"
echo "switched to $name"
